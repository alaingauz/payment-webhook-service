# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=webhooks
DB_POOL_MAX=10

# Application
PORT=3000
MODE=api

# Worker
WORKER_POLL_INTERVAL_MS=100
WORKER_ERROR_DELAY_MS=500
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_MS=500
WORKER_RETRY_MAX_MS=30000

# Webhook HMAC (development only)
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Provider
PROVIDER_BASE_URL=http://localhost:4000
PROVIDER_TIMEOUT_MS=5000
